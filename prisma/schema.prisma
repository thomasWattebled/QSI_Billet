generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  CREATED
  USED
  REFUNDED
  CANCELED
  EXPIRED
}

model User {
  userId  String   @id @default(uuid())
  name    String
}

model Concert {
  id         String   @id @default(uuid())
  name       String
  location   String
  date       DateTime
  price      Float?
  maxTickets Int
  deletedAt  DateTime?
}

model Ticket {
  ticketId   String       @id @default(uuid())
  concertId  String
  ownerId    String
  status     TicketStatus @default(CREATED)
  isAvailable Boolean     @default(true)
  createdAt  DateTime     @default(now())
  deletedAt  DateTime?
  price      Float?
  updatedAt  DateTime     @updatedAt
}
